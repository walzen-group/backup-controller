# Keep the image build context to what go build reads. In particular .git is
# never in the context, so the build cannot depend on repository metadata, and
# nothing in deploy/, chart/, or docs/ can leak into the final image.
.git
.github
.tmp
.cortex
.direnv
result
result-*
docs
chart
deploy
# Test tooling and recordings: the image builds ./cmd/backup-controller only, and
# the e2e components' caches under hack/ would otherwise change the image on
# every fetch.
hack
.claude
**/testdata
internal/testinfra
nix
