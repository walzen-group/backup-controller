# The versions hack/kind/up.sh installs. They match walzen prod, except the
# CSI driver: prod runs zfs-localpv, and the test cluster runs the host path
# driver for claims, snapshots and clones.

CERT_MANAGER_CHART=oci://quay.io/jetstack/charts/cert-manager
CERT_MANAGER_VERSION=v1.21.2

CNPG_CHART=oci://ghcr.io/cloudnative-pg/charts/cloudnative-pg
CNPG_VERSION=0.29.0 # operator 1.30.0

BARMAN_PLUGIN_CHART=oci://ghcr.io/cloudnative-pg/charts/plugin-barman-cloud
BARMAN_PLUGIN_VERSION=0.8.0 # plugin v0.15.0, barman 3.20.0

VOLSYNC_REPO=https://backube.github.io/helm-charts
VOLSYNC_VERSION=0.16.0 # restic 0.18.1 in the mover

KUEUE_CHART=oci://registry.k8s.io/kueue/charts/kueue
KUEUE_VERSION=0.19.5

FLUX_INSTALL=https://github.com/fluxcd/flux2/releases/download/v2.9.5/install.yaml

RUSTFS_IMAGE=docker.io/rustfs/rustfs:1.0.0
AWS_CLI_IMAGE=docker.io/amazon/aws-cli:2.37.4
REGISTRY_IMAGE=docker.io/library/registry:3.0.0

# PostgreSQL image of every test Cluster, as prod's Clusters set spec.imageName.
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6

SNAPSHOTTER_VERSION=v8.6.0
CSI_HOSTPATH_VERSION=v1.18.0
